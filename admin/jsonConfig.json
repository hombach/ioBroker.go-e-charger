{
	"i18n": true,
	"type": "tabs",
	"items": {
		"_StandardTab": {
			"type": "panel",
			"label": "LBL_standardSettings",
			"items": {
				"cycleTime": {
					"type": "number",
					"label": "LBL_cycleTime",
					"min": 3000,
					"max": 3600000,
					"step": 100,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true,
					"unit": "ms"
				},
				"maxChargeCurrent": {
					"type": "number",
					"label": "LBL_maxChargeCurrent",
					"help": "LBL_maxChargeCurrentHelp",
					"default": 16,
					"min": 10,
					"max": 32,
					"step": 1,
					"unit": "A",
					"validator": "data.maxChargeCurrent >= data.chargeManagerMinCurrent",
					"validatorNoSaveOnError": true,
					"validatorErrorText": "ERR_maxCurrentBelowMin",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": false
				},
				"maxAmpTotal": {
					"type": "number",
					"label": "LBL_maxAmpTotal",
					"help": "LBL_maxAmpTotalHelp",
					"default": 16,
					"min": 6,
					"max": 64,
					"step": 1,
					"unit": "A",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true
				},
				"wallBoxList": {
					"type": "accordion",
					"titleAttr": "chargerName",
					"label": "LBL_wallBoxList",
					"help": "LBL_wallBoxListHelp",
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"items": [
						{
							"type": "text",
							"label": "LBL_chargerName",
							"attr": "chargerName",
							"maxLength": 20,
							"xs": 12,
							"sm": 12,
							"md": 6,
							"lg": 6,
							"xl": 4
						},
						{
							"type": "text",
							"label": "LBL_ipAddress",
							"attr": "ipAddress",
							"maxLength": 15,
							"xs": 12,
							"sm": 12,
							"md": 6,
							"lg": 6,
							"xl": 4
						},
						{
							"type": "checkbox",
							"label": "LBL_readOnlyMode",
							"attr": "readOnlyMode",
							"xs": 12,
							"sm": 12,
							"md": 6,
							"lg": 6,
							"xl": 4
						},
						{
							"type": "number",
							"label": "LBL_wallboxMinAmp",
							"help": "LBL_wallboxMinAmpHelp",
							"attr": "minAmp",
							"default": 0,
							"min": 0,
							"max": 32,
							"step": 1,
							"unit": "A",
							"xs": 12,
							"sm": 6,
							"md": 6,
							"lg": 6,
							"xl": 4,
							"newLine": true
						},
						{
							"type": "number",
							"label": "LBL_wallboxMaxAmp",
							"help": "LBL_wallboxMaxAmpHelp",
							"attr": "maxAmp",
							"default": 0,
							"min": 0,
							"max": 32,
							"step": 1,
							"unit": "A",
							"xs": 12,
							"sm": 6,
							"md": 6,
							"lg": 6,
							"xl": 4
						},
						{
							"type": "checkbox",
							"label": "LBL_autoPhaseSwitch",
							"help": "LBL_autoPhaseSwitchHelp",
							"attr": "autoPhaseSwitch",
							"xs": 12,
							"sm": 12,
							"md": 12,
							"lg": 12,
							"xl": 12,
							"newLine": true
						},
						{
							"type": "checkbox",
							"label": "LBL_stopWhenCarIdle",
							"help": "LBL_stopWhenCarIdleHelp",
							"attr": "stopWhenCarIdle",
							"xs": 12,
							"sm": 12,
							"md": 12,
							"lg": 12,
							"xl": 12,
							"newLine": true
						}
					]
				}
			}
		},
		"_ChargeManagerTab": {
			"type": "panel",
			"label": "LBL_chargeManagerSettings",
			"items": {
				"_headerSurplusInput": {
					"type": "header",
					"text": "LBL_headerSurplusInput",
					"size": 5,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"newLine": true
				},
				"gridMode": {
					"type": "select",
					"label": "LBL_gridMode",
					"help": "LBL_gridModeHelp",
					"default": "pvAndConsumption",
					"options": [
						{
							"label": "LBL_gridModePvAndConsumption",
							"value": "pvAndConsumption"
						},
						{
							"label": "LBL_gridModeGridMeter",
							"value": "gridMeter"
						}
					],
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true
				},
				"stateHomeSolarPower": {
					"type": "objectId",
					"label": "LBL_stateHomeSolarPower",
					"xs": 12,
					"sm": 8,
					"md": 8,
					"lg": 8,
					"xl": 8,
					"newLine": true,
					"hidden": "data.gridMode === 'gridMeter'"
				},
				"solarPowerNegate": {
					"type": "checkbox",
					"label": "LBL_solarPowerNegate",
					"help": "LBL_solarPowerNegateHelp",
					"default": false,
					"xs": 12,
					"sm": 4,
					"md": 4,
					"lg": 4,
					"xl": 4,
					"newLine": false,
					"hidden": "data.gridMode === 'gridMeter'"
				},
				"stateHomePowerConsumption": {
					"type": "objectId",
					"label": "LBL_stateHomePowerConsumption",
					"xs": 12,
					"sm": 8,
					"md": 8,
					"lg": 8,
					"xl": 8,
					"newLine": true,
					"hidden": "data.gridMode === 'gridMeter'"
				},
				"homePowerConsumptionNegate": {
					"type": "checkbox",
					"label": "LBL_homePowerConsumptionNegate",
					"help": "LBL_homePowerConsumptionNegateHelp",
					"default": false,
					"xs": 12,
					"sm": 4,
					"md": 4,
					"lg": 4,
					"xl": 4,
					"newLine": false,
					"hidden": "data.gridMode === 'gridMeter'"
				},
				"subtractSelfConsumption": {
					"type": "checkbox",
					"label": "LBL_subtractSelfConsumption",
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"newLine": true,
					"hidden": "data.gridMode === 'gridMeter'"
				},
				"stateGridPower": {
					"type": "objectId",
					"label": "LBL_stateGridPower",
					"help": "LBL_stateGridPowerHelp",
					"default": "",
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true,
					"hidden": "data.gridMode !== 'gridMeter'"
				},
				"gridPowerNegate": {
					"type": "checkbox",
					"label": "LBL_gridPowerNegate",
					"help": "LBL_gridPowerNegateHelp",
					"default": false,
					"xs": 12,
					"sm": 6,
					"md": 3,
					"lg": 3,
					"xl": 3,
					"newLine": false,
					"hidden": "data.gridMode !== 'gridMeter'"
				},
				"gridPowerAckOnly": {
					"type": "checkbox",
					"label": "LBL_gridPowerAckOnly",
					"help": "LBL_gridPowerAckOnlyHelp",
					"default": false,
					"xs": 12,
					"sm": 6,
					"md": 3,
					"lg": 3,
					"xl": 3,
					"newLine": false,
					"hidden": "data.gridMode !== 'gridMeter'"
				},
				"gridPowerMaxAgeSeconds": {
					"type": "number",
					"label": "LBL_gridPowerMaxAgeSeconds",
					"help": "LBL_gridPowerMaxAgeSecondsHelp",
					"default": 0,
					"min": 0,
					"max": 86400,
					"step": 1,
					"unit": "s",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true,
					"hidden": "data.gridMode !== 'gridMeter'"
				},
				"_headerHomeBattery": {
					"type": "header",
					"text": "LBL_headerHomeBattery",
					"size": 5,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"newLine": true
				},
				"batteryMode": {
					"type": "select",
					"label": "LBL_batteryMode",
					"default": "priority",
					"options": [
						{
							"label": "LBL_batteryModeDisabled",
							"value": "disabled",
							"description": "LBL_batteryModeDisabledDescription"
						},
						{
							"label": "LBL_batteryModeMinimumSoc",
							"value": "minimumSoc",
							"description": "LBL_batteryModeMinimumSocDescription"
						},
						{
							"label": "LBL_batteryModePriority",
							"value": "priority",
							"description": "LBL_batteryModePriorityDescription"
						}
					],
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true
				},
				"stateHomeBatSoc": {
					"type": "objectId",
					"label": "LBL_stateHomeBatSoc",
					"xs": 12,
					"sm": 8,
					"md": 8,
					"lg": 8,
					"xl": 8,
					"newLine": true,
					"hidden": "data.batteryMode === 'disabled'"
				},
				"batterySocHysteresis": {
					"type": "number",
					"label": "LBL_batterySocHysteresis",
					"default": 0,
					"min": 0,
					"max": 20,
					"step": 0.5,
					"unit": "%",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true,
					"hidden": "data.batteryMode === 'disabled'"
				},
				"batterySocMaxAgeSeconds": {
					"type": "number",
					"label": "LBL_batterySocMaxAgeSeconds",
					"default": 0,
					"min": 0,
					"max": 86400,
					"step": 1,
					"unit": "s",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": false,
					"hidden": "data.batteryMode === 'disabled'"
				},
				"chargeManagerMaxBatteryBonus": {
					"type": "number",
					"label": "LBL_chargeManagerMaxBatteryBonus",
					"default": 2000,
					"min": 0,
					"max": 10000,
					"step": 100,
					"unit": "W",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true,
					"hidden": "data.batteryMode !== 'priority'"
				},
				"_headerSurplusControl": {
					"type": "header",
					"text": "LBL_headerSurplusControl",
					"size": 5,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"newLine": true
				},
				"chargeManagerReservePower": {
					"type": "number",
					"label": "LBL_chargeManagerReservePower",
					"default": 100,
					"min": 0,
					"max": 2000,
					"step": 10,
					"unit": "W",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true
				},
				"chargeManagerMinCurrent": {
					"type": "number",
					"label": "LBL_chargeManagerMinCurrent",
					"default": 6,
					"min": 6,
					"max": 16,
					"step": 1,
					"unit": "A",
					"validator": "data.chargeManagerMinCurrent <= data.maxChargeCurrent",
					"validatorNoSaveOnError": true,
					"validatorErrorText": "ERR_minCurrentAboveMax",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": false
				}
			}
		}
	}
}
