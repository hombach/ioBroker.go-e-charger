{
	"i18n": true,
	"type": "tabs",
	"items": {
		"_StandardTab": {
			"type": "panel",
			"label": "LBL_standardSettings",
			"items": {
				"cycleTime": {
					"type": "number",
					"label": "LBL_cycleTime",
					"min": 3000,
					"max": 3600000,
					"step": 100,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true
				},
				"maxChargeCurrent": {
					"type": "number",
					"label": "LBL_maxChargeCurrent",
					"help": "LBL_maxChargeCurrentHelp",
					"default": 16,
					"min": 10,
					"max": 32,
					"step": 1,
					"unit": "A",
					"validator": "data.maxChargeCurrent >= data.chargeManagerMinCurrent",
					"validatorNoSaveOnError": true,
					"validatorErrorText": "ERR_maxCurrentBelowMin",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": false
				},
				"wallBoxList": {
					"type": "accordion",
					"titleAttr": "chargerName",
					"label": "LBL_wallBoxList",
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"items": [
						{
							"type": "text",
							"label": "LBL_chargerName",
							"attr": "chargerName",
							"maxLength": 20,
							"xs": 12,
							"sm": 12,
							"md": 6,
							"lg": 6,
							"xl": 4
						},
						{
							"type": "text",
							"label": "LBL_ipAddress",
							"attr": "ipAddress",
							"maxLength": 15,
							"xs": 12,
							"sm": 12,
							"md": 6,
							"lg": 6,
							"xl": 4
						},
						{
							"type": "checkbox",
							"label": "LBL_readOnlyMode",
							"attr": "readOnlyMode",
							"xs": 12,
							"sm": 12,
							"md": 6,
							"lg": 6,
							"xl": 4
						}
					]
				}
			}
		},
		"_ChargeManagerTab": {
			"type": "panel",
			"label": "LBL_chargeManagerSettings",
			"items": {
				"stateHomeSolarPower": {
					"type": "objectId",
					"label": "LBL_stateHomeSolarPower",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true
				},
				"stateHomeBatSoc": {
					"type": "objectId",
					"label": "LBL_stateHomeBatSoc",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": false,
					"hidden": "data.batteryMode === 'disabled'"
				},
				"batteryMode": {
					"type": "select",
					"label": "LBL_batteryMode",
					"default": "priority",
					"options": [
						{
							"label": "LBL_batteryModeDisabled",
							"value": "disabled",
							"description": "LBL_batteryModeDisabledDescription"
						},
						{
							"label": "LBL_batteryModeMinimumSoc",
							"value": "minimumSoc",
							"description": "LBL_batteryModeMinimumSocDescription"
						},
						{
							"label": "LBL_batteryModePriority",
							"value": "priority",
							"description": "LBL_batteryModePriorityDescription"
						}
					],
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true
				},
				"stateHomePowerConsumption": {
					"type": "objectId",
					"label": "LBL_stateHomePowerConsumption",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true
				},
				"subtractSelfConsumption": {
					"type": "checkbox",
					"label": "LBL_subtractSelfConsumption",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": false
				},
				"chargeManagerReservePower": {
					"type": "number",
					"label": "LBL_chargeManagerReservePower",
					"default": 100,
					"min": 0,
					"max": 2000,
					"step": 10,
					"unit": "W",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true
				},
				"chargeManagerMaxBatteryBonus": {
					"type": "number",
					"label": "LBL_chargeManagerMaxBatteryBonus",
					"default": 2000,
					"min": 0,
					"max": 10000,
					"step": 100,
					"unit": "W",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": false,
					"hidden": "data.batteryMode !== 'priority'"
				},
				"chargeManagerMinCurrent": {
					"type": "number",
					"label": "LBL_chargeManagerMinCurrent",
					"default": 6,
					"min": 6,
					"max": 16,
					"step": 1,
					"unit": "A",
					"validator": "data.chargeManagerMinCurrent <= data.maxChargeCurrent",
					"validatorNoSaveOnError": true,
					"validatorErrorText": "ERR_minCurrentAboveMax",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true
				},
				"batterySocHysteresis": {
					"type": "number",
					"label": "LBL_batterySocHysteresis",
					"default": 0,
					"min": 0,
					"max": 20,
					"step": 0.5,
					"unit": "%",
					"hidden": "data.batteryMode === 'disabled'",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": true
				},
				"batterySocMaxAgeSeconds": {
					"type": "number",
					"label": "LBL_batterySocMaxAgeSeconds",
					"default": 0,
					"min": 0,
					"max": 86400,
					"step": 1,
					"unit": "s",
					"hidden": "data.batteryMode === 'disabled'",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6,
					"newLine": false
				}
			}
		}
	}
}
